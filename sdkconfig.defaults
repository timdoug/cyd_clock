# Flash (CYD has 4MB Boya chip)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"

# RTC clock: use internal 8.5MHz oscillator / 256 (more accurate than RC)
# 8x default calibration cycles for more accurate RTC tick measurement
CONFIG_RTC_CLK_SRC_INT_8MD256=y
CONFIG_RTC_CLK_CAL_CYCLES=8192

# FreeRTOS (1kHz tick for smoother timing)
CONFIG_FREERTOS_HZ=1000

# Performance / display timing: -O2 and 240 MHz shrink compose latency and
# jitter; the main task (render loop) gets core 1 to itself while WiFi
# (pinned by default), lwip, and the chronyd task stay on core 0, so network
# bursts can't stretch a display tick mid-draw.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# chronyd resolves names in a short-lived pthread (nameserv_async.c); keep
# it on the network core with the rest of chronyd. The 3 KB default stack
# leaves little margin under lwIP's getaddrinfo().
CONFIG_PTHREAD_DEFAULT_CORE_0=y
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Networking
# Up to 4 addresses per family from one DNS answer, for chronyd's pool.
CONFIG_LWIP_DNS_MAX_HOST_IP=4
# chronyd opens a UDP socket per request to each source (a pool holds up to
# 8 records while it confirms 4), a TCP socket per concurrent NTS-KE session,
# and two loopback pairs that stand in for pipe() (port/chronyd_esp.c),
# alongside OTA's HTTPS socket.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_CHECKSUM_CHECK_IP=y
CONFIG_LWIP_CHECKSUM_CHECK_UDP=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_RDNSS_MAX_DNS_SERVERS=3
CONFIG_LWIP_IPV6_DHCP6=y
CONFIG_LWIP_IPV6_ND6_ROUTE_INFO_OPTION_SUPPORT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Root CAs come from the vendored Mozilla bundle (make update-certs), not
# the snapshot shipped with the installed ESP-IDF.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_NONE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="third_party/ca-certificates/cacert.pem"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# TLS 1.3 client + RFC 8446 keying-material exporter: required for NTS-KE
# (RFC 8915). NTS mandates TLS 1.3, and the exporter derives the c2s/s2c
# AEAD keys from the handshake. ALPN is already on by default.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_KEYING_MATERIAL_EXPORT=y
# Check certificate validity dates against the system clock (chronyd's
# "nocerttimecheck 1" covers NTS-KE before the first clock update; OTA
# refuses to start until the clock is set).
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# chronyd runs one NTS-KE session per NTS source, concurrently. With
# dynamic buffers a session holds TLS record buffers only while a record is
# in flight, not for its whole life (a session can wait up to 16 s on a
# filtered port 4460), so concurrent sessions do not each pin ~20 KB.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# The classic ESP32 has no hardware ECC, so an all-ECDSA chain (e.g.
# Cloudflare's secp384r1) is verified in software and can race a KE server's
# handshake idle timeout. Fixed-point optimization precomputes base-point
# tables, speeding the ECDHE share and the fixed-point half of ECDSA verify.
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y

# Reproducible builds: no __DATE__/__TIME__ in the app or bootloader
# descriptors, and host paths remapped in debug info so the image is
# byte-identical across checkout paths. tools/clear_elf_sha256.py also
# zeroes the app_elf_sha256 stamp, the one field that differed between
# macOS and Linux builds (their toolchains' prebuilt libraries differ).
# (the era anchor in util.h is a hardcoded year for the same reason)
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Display tick timer fires via ISR dispatch (semaphore give from the timer
# interrupt) so the esp_timer task - shared with WiFi's timers - is out of
# the path from second boundary to pixels
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# OTA rollback: a new image boots as PENDING_VERIFY and main.c marks it
# valid once the app is up; if it crash-loops before that, the bootloader
# falls back to the previous slot instead of bricking the clock. (OTA never
# updates the bootloader, so devices flashed before this setting gain the
# bootloader half of the protection at their next wired flash.)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Watchdog the main task: a clock frozen on a stale time is the worst
# failure mode a clock can have. 30 s window clears the longest legitimate
# block (wifi_connect's 15 s verdict wait); panic -> reboot -> recover.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
